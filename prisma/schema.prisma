generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// CORE USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId      String         @unique
  email        String         @unique
  firstname    String?
  lastname     String?
  password     String?
  createdAt    DateTime       @default(now())
  subscription Subscription?
  integrations Integrations[]
  automations  Automation[]
  contacts     Contact[]
  memberships  OrgMember[]
}

model OrgMember {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String     @db.Uuid
  orgId  String     @db.Uuid
  role   MemberRole @default(OWNER)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

enum MemberRole {
  OWNER
  EDITOR
}

model Subscription {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  User       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?           @unique @db.Uuid
  createdAt  DateTime          @default(now())
  plan       SUBSCRIPTION_PLAN @default(PRO)
  updatedAt  DateTime          @default(now())
  customerId String?           @unique
}

// ═══════════════════════════════════════════════════════════════
// ORGANIZATION (replaces old "Business" model)
// ═══════════════════════════════════════════════════════════════

model Organization {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  name            String
  tagline         String?
  description     String?
  targetAudience  String?
  painPoints      String[]
  contentPillars  String[]
  voiceTone       String?
  language        String   @default("hinglish")
  hinglishRatio   String?  @default("65% Hindi, 35% English")
  cta             String?
  hashtags        String?
  complianceNotes String?
  logoUrl         String?
  brandColors     Json?
  ttsProvider     String   @default("auto")
  ttsVoiceId      String?
  postizChannels  String[]
  postsPerDay     Int      @default(1)
  active          Boolean  @default(false)
  winningPatterns String?
  createdAt       DateTime @default(now())

  // Relationships
  members         OrgMember[]
  integrations    Integrations[]
  automations     Automation[]
  contacts        Contact[]
  skills          Skill[]
  pipelines       PipelineConfig[]
  jobs            ContentJob[]
  ideas           ContentIdea[]
  logs            DocumentaryLog[]
  scraped         ScrapedPost[]
}

// ═══════════════════════════════════════════════════════════════
// INSTAGRAM DM AUTOMATION (LinkPlease)
// ═══════════════════════════════════════════════════════════════

model Integrations {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        INTEGRATIONS  @default(INSTAGRAM)
  createdAt   DateTime      @default(now())
  User        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?       @db.Uuid
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String?       @db.Uuid
  token       String        @unique
  expiresAt   DateTime?
  instagramId String?       @unique
}

model Automation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @default("Untitled")
  createdAt DateTime  @default(now())
  active    Boolean   @default(false)
  trigger   Trigger[]
  listener  Listener?
  posts     Post[]
  dms       Dms[]
  User      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?   @db.Uuid
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String?   @db.Uuid
  keywords  Keyword[]
}

model Dms {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Automation   Automation? @relation(fields: [automationId], references: [id])
  automationId String?     @db.Uuid
  createdAt    DateTime    @default(now())
  senderId     String?
  reciever     String?
  message      String?
}

model Post {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postid       String
  caption      String?
  media        String
  mediaType    MEDIATYPE   @default(IMAGE)
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String?     @db.Uuid
}

model Listener {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String     @unique @db.Uuid
  listener     LISTENERS  @default(MESSAGE)
  prompt       String
  commentReply String?
  dmCount      Int        @default(0)
  commentCount Int        @default(0)
}

model Trigger {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String?     @db.Uuid
}

model Keyword {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  word         String
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String?     @db.Uuid

  @@unique([automationId, word])
}

model Contact {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instagramId  String
  username     String?
  createdAt    DateTime      @default(now())
  User         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?       @db.Uuid
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String?       @db.Uuid

  @@unique([userId, instagramId])
}

// ═══════════════════════════════════════════════════════════════
// SKILLS & STYLE REFERENCES (/watch feature)
// ═══════════════════════════════════════════════════════════════

model Skill {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String      @db.Uuid
  name              String
  type              SkillType
  description       String?
  skillFilePath     String?     // path to SKILL.md on disk
  config            Json?       // parsed skill parameters
  isVisual          Boolean     @default(false)
  createdAt         DateTime    @default(now())

  org               Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  styleReference    StyleReference?
  pipelineSteps     PipelineStep[]
}

model StyleReference {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId           String   @unique @db.Uuid
  referenceVideoUrl String?  // URL or file path to the reference video
  thumbnailUrl      String?  // static thumbnail
  analysisJson      Json?    // extracted style analysis (pacing, overlays, colors, etc.)
  frameExtracts     String[] // paths to extracted keyframes
  createdAt         DateTime @default(now())

  skill             Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

enum SkillType {
  EDITING_STYLE
  CAPTION_STYLE
  BROLL_GENERATION
  CLIP_GENERATION
  SCRAPER
  ANALYTICS
  VOICE
  CUSTOM
}

// ═══════════════════════════════════════════════════════════════
// PIPELINE TEMPLATES (Manufacturer's View)
// ═══════════════════════════════════════════════════════════════

model PipelineConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  templateId  String   // "talking-head-reel", "faceless-explainer", etc.
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  org   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  steps PipelineStep[]
}

model PipelineStep {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId String   @db.Uuid
  stepType   StepType
  orderIndex Int
  isEnabled  Boolean  @default(true)
  skillId    String?  @db.Uuid
  config     Json?
  
  pipeline PipelineConfig @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  skill    Skill?         @relation(fields: [skillId], references: [id])

  @@unique([pipelineId, orderIndex])
}

enum StepType {
  IDEATION
  SCRIPT
  AUDIO_TTS
  FOOTAGE_PREP
  VIDEO_EDIT
  BROLL_INJECTION
  CAPTION_OVERLAY
  THUMBNAIL
  REVIEW
}

// ═══════════════════════════════════════════════════════════════
// CONTENT ENGINE
// ═══════════════════════════════════════════════════════════════

model ContentIdea {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String       @db.Uuid
  topic         String
  angle         String
  hookStyle     String
  contentPillar String
  source        String       @default("llm")
  used          Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model ContentJob {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String       @db.Uuid
  ideaId       String?      @db.Uuid
  pipelineId   String?      @db.Uuid  // which pipeline template was used
  status       JOB_STATUS   @default(IDEA)
  script       Json?
  caption      String?
  audioKey     String?
  videoKey     String?
  renderLog    String?
  postizPostId String?
  scheduledAt  DateTime?
  publishedAt  DateTime?
  rejectReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  metrics      PostMetric[]
}

enum JOB_STATUS {
  IDEA
  SCRIPTED
  RENDERING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  FAILED
}

model PostMetric {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job       ContentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String     @db.Uuid
  platform  String
  views     Int        @default(0)
  likes     Int        @default(0)
  comments  Int        @default(0)
  shares    Int        @default(0)
  saves     Int        @default(0)
  followers Int        @default(0)
  fetchedAt DateTime   @default(now())
}

// ═══════════════════════════════════════════════════════════════
// INTELLIGENCE (Competitive Research)
// ═══════════════════════════════════════════════════════════════

model ScrapedPost {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId    String       @db.Uuid
  platform String
  handle   String
  url      String
  caption  String?
  transcript String?
  views    Int          @default(0)
  likes    Int          @default(0)
  comments Int          @default(0)
  er       Float        @default(0)
  score    Float        @default(0)
  cluster  String?
  postDate DateTime?
  createdAt DateTime    @default(now())
  
  // Video Analysis fields
  status       String       @default("COMPLETED")
  analysisData Json?
}

model DocumentaryLog {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId    String       @db.Uuid
  event    String
  detail   Json?
  createdAt DateTime    @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum SUBSCRIPTION_PLAN {
  PRO
  FREE
}

enum INTEGRATIONS {
  INSTAGRAM
}

enum MEDIATYPE {
  IMAGE
  VIDEO
  CAROSEL_ALBUM
}

enum LISTENERS {
  SMARTAI
  MESSAGE
}
